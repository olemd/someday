# SPDX-License-Identifier: AGPL-3.0-or-later
# Environment for the self-hosted server (docs/self-hosting.md).
# Copy to ~/.config/someday/someday.env (Quadlet) or .env (bun run start),
# and keep it private: chmod 600. Names match the Cloudflare vars/secrets.

# Public address (required): passkeys, OAuth issuer and push deep links.
PUBLIC_ORIGIN=https://someday.example.com

# Pepper for all stored token hashes (required, ≥ 32 characters). Prefer a
# Podman secret: TOKEN_PEPPER_FILE=/run/secrets/token_pepper (see the unit).
# Generate: openssl rand -base64 48
TOKEN_PEPPER_FILE=/run/secrets/token_pepper

# One-time token for /setup?token=… (creates the first admin; ≥ 16 characters).
BOOTSTRAP_ADMIN_TOKEN=

# Web Push (optional; both or none). Generate with `bun run vapid` in a checkout.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com   (defaults to PUBLIC_ORIGIN)

# Addresses of your reverse proxy, as the server sees them (IPs or CIDRs), so
# rate limits see real client addresses. If the server logs "X-Forwarded-For
# from an untrusted address", add the proxy_address it shows.
TRUSTED_PROXIES=127.0.0.1,::1

# Point at your own repository if you run a modified version (AGPL §13).
SOURCE_URL=https://github.com/olemd/someday

# Every other default from src/core/config.ts can be overridden here too, e.g.
# REGISTRATION_MODE=invite   (invite | open | closed)
# DEVICE_LINK_TTL_MIN=15
# ANON_COUNT_MIN_MEMBERS=4
