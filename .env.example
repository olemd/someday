# Local values for `bun run render-config` (scripts/render-wrangler-config.ts).
# Secrets (TOKEN_PEPPER, BOOTSTRAP_ADMIN_TOKEN, VAPID_*) go in .dev.vars for
# local development and in `wrangler secret put` for production.
WORKER_NAME=someday
PUBLIC_ORIGIN=http://localhost:8787
D1_DATABASE_ID=00000000-0000-0000-0000-000000000000
CUSTOM_DOMAIN=
SOURCE_URL=https://github.com/olemd/someday
